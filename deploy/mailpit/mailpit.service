[Unit]
Description=Mailpit catch-all OTP mailbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailpit
Group=mailpit
WorkingDirectory=/opt/mailpit
EnvironmentFile=/opt/mailpit/mailpit.env
EnvironmentFile=-/opt/mailpit/recipients.env
ExecStart=/opt/mailpit/mailpit
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=65535
ReadWritePaths=/opt/mailpit/data
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
